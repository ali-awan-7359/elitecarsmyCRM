# Companies House — free API key: https://developer.companieshouse.gov.uk
# Sign in, add an app, use the "API key" from the app's settings page.
COMPANIES_HOUSE_API_KEY=

# Optional: Apollo.io enrichment. Leave blank to use website scraping only.
APOLLO_API_KEY=

# SMTP for sending as ali@elite-cars.co.uk
# Examples: smtp.elasticemail.com, smtp.ionos.co.uk, smtp.gmail.com (app password required)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ali@elite-cars.co.uk
SMTP_PASS=

# Envelope sender and From name used on every outgoing email
MAIL_FROM=ali@elite-cars.co.uk
MAIL_FROM_NAME=Ali at Elite Cars

# Public URL of this app, used to build one-click unsubscribe links.
# Set to your real host once deployed, otherwise defaults to localhost:3000.
APP_URL=http://localhost:3000